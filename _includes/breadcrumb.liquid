{%- comment -%}
  Bootstrap-style breadcrumb (markup follows Bootstrap's breadcrumb component;
  styles live in _sass/_bs-components.scss, no Bootstrap library is loaded).

  Home > [section] > current page. Hidden on the home page and on pages that set
  `breadcrumb: false` in their front matter. Section links are added for items
  in a collection (projects, posts, news, books).
{%- endcomment -%}
{%- assign bc_home = '/' | relative_url -%}
{%- unless page.url == '/' or page.url == '/index.html' or page.breadcrumb == false or page.layout == 'about' -%}
  {%- assign bc_section_title = nil -%}
  {%- assign bc_section_url = nil -%}
  {%- case page.collection -%}
    {%- when 'projects' -%}
      {%- assign bc_section_title = 'Projects' -%}
      {%- assign bc_section_url = '/projects/' -%}
    {%- when 'posts' -%}
      {%- assign bc_section_title = 'Blog' -%}
      {%- assign bc_section_url = '/blog/' -%}
    {%- when 'news' -%}
      {%- assign bc_section_title = 'News' -%}
      {%- assign bc_section_url = '/news/' -%}
    {%- when 'books' -%}
      {%- assign bc_section_title = 'Bookshelf' -%}
      {%- assign bc_section_url = '/books/' -%}
  {%- endcase -%}

  {%- assign bc_title = page.title | default: page.date | default: 'Page' | strip_html | strip -%}
  {%- if page.collection == 'news' and page.inline -%}
    {%- assign bc_title = page.date | date: '%b %-d, %Y' -%}
  {%- endif -%}
  {%- assign bc_lower = bc_title | downcase -%}
  {%- if bc_title == bc_lower -%}
    {%- assign bc_title = bc_title | capitalize -%}
  {%- endif -%}

  <nav aria-label="breadcrumb" class="site-breadcrumb">
    <div class="container">
    <ol class="breadcrumb">
      <li class="breadcrumb-item">
        <a href="{{ bc_home }}"><i class="fa-solid fa-house" aria-hidden="true"></i> Home</a>
      </li>
      {%- if bc_section_title %}
        <li class="breadcrumb-item"><a href="{{ bc_section_url | relative_url }}">{{ bc_section_title }}</a></li>
      {%- endif %}
      <li class="breadcrumb-item active" aria-current="page">{{ bc_title | truncate: 70 }}</li>
    </ol>
    </div>
  </nav>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ '/' | absolute_url | jsonify }} }
        {%- if bc_section_title -%}
          , { "@type": "ListItem", "position": 2, "name": {{ bc_section_title | jsonify }}, "item": {{ bc_section_url | absolute_url | jsonify }} }
          , { "@type": "ListItem", "position": 3, "name": {{ bc_title | jsonify }} }
        {%- else -%}
          , { "@type": "ListItem", "position": 2, "name": {{ bc_title | jsonify }} }
        {%- endif -%}
      ]
    }
  </script>
{%- endunless -%}
